# ===========================================================================
# LitIntel .env -- IDENTITY ONLY
#
# This file answers WHERE things run and AS WHOM. It holds accounts, projects,
# credential file paths, and resource IDs -- nothing else.
#
# Every model, thinking level, and threshold lives in configs/*.yaml instead.
# There are deliberately no env-var overrides for those: an earlier override
# block let .env silently win, so the committed config stopped matching what
# actually ran. Do not reintroduce it.
#
#   .env          -> WHERE / AS WHOM   (this file)
#   configs/*.yaml-> HOW               (models, thinking, thresholds, top_k)
#
# Run `litintel doctor` to see how all of this resolved, or
# `litintel doctor --check` to prove each credential with a live API call.
# ===========================================================================


# ---------------------------------------------------------------------------
# NCBI / PubMed
# NCBI_EMAIL is mandatory -- pubmed/client.py raises without it rather than
# falling back to a placeholder, which would misattribute the traffic.
# The API key raises the rate limit from 3 req/s to 10 req/s.
# ---------------------------------------------------------------------------
NCBI_EMAIL="you@institution.edu"
NCBI_API_KEY=""


# ---------------------------------------------------------------------------
# Notion
# ---------------------------------------------------------------------------
NOTION_TOKEN="ntn_xxx"
NOTION_DB_ID="xxx"


# ===========================================================================
# GOOGLE IDENTITY 1 of 3 -- GEMINI INFERENCE
#
# Vertex AI on the COMPANY project, authenticated by the ambient ADC:
#     gcloud auth application-default login
# Used only for Gemini model calls. Never used for the RAG corpus or Drive.
# ===========================================================================
USE_VERTEX_AI=true
GCP_PROJECT_ID='prj-kun-cpdr-prod-nsmc'
GCP_LOCATION='global'

# Set USE_VERTEX_AI=false to use the API-key path instead, which needs:
# GOOGLE_API_KEY=xxx


# ===========================================================================
# GOOGLE IDENTITY 2 of 3 -- VERTEX RAG CORPUS
#
# A PERSONAL project, authenticated by a service-account key. The corpus
# project and region are parsed from VERTEX_RAG_CORPUS_NAME; GCP_PROJECT_ID
# above is NOT consulted, so the two identities cannot bleed into each other.
#
# RAG_CREDENTIALS_JSON is required whenever the corpus project differs from
# whatever the ambient ADC is authenticated against -- the company ADC gets
# 403 on a personal project.
#
# Create a corpus with scripts/create_rag_corpus.py.
# ===========================================================================
VERTEX_RAG_CORPUS_NAME='projects/1040326808351/locations/us-east5/ragCorpora/3596124302455341056'
RAG_CREDENTIALS_JSON="/path/to/personal-service-account.json"


# ===========================================================================
# GOOGLE IDENTITY 3 of 3 -- PERSONAL GOOGLE DRIVE
#
# User OAuth, cached in token_drive.json. A GCP service account CANNOT write
# to personal Drive even when the folder is shared with it -- these are not
# interchangeable. Authorize with:
#     python scripts/auth/auth_google_drive.py
#
# Pin every destination ID. Without them LitIntel falls back to lookup by
# name and will create duplicate folders and files.
# ===========================================================================
GOOGLE_DRIVE_CLIENT_SECRET="/path/to/oauth-client-secret.json"
# GOOGLE_DRIVE_TOKEN_PATH="token_drive.json"

GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_PAPERS_JSONL_FILE_ID=""
GOOGLE_DRIVE_NOTEBOOKLM_FOLDER_ID=""
GOOGLE_DRIVE_COMP_METHODS_FOLDER_ID=""
GOOGLE_DRIVE_PDF_FOLDER_ID=""
GOOGLE_DRIVE_TIERC_INBOX_FOLDER_ID=""
GOOGLE_DRIVE_TIERC_OUTPUT_FOLDER_ID=""


# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
RUN_LOG_PATH=run_history.csv
